specification {
  element pessoa {
    notation "Pessoa"
    style {
      shape person
      color muted
    }
  }
  element sistemaExterno {
    notation "Sistema externo"
    style {
      color secondary
    }
  }
  element sistema {
    notation "Sistema"
  }
  element conteiner {
    notation "Contêiner"
  }
  element componente {
    notation "Componente"
  }
  element banco {
    notation "Banco ou armazenamento"
    style {
      shape storage
    }
  }

  // Marcas do alvo (df-8x0m.23.37): o que difere de hoje.c4 leva uma delas e metadata { bead }
  // com o id de um bead aberto; scripts/arquitetura/marcas.py confere.
  tag novo {
    color green
  }
  tag muda {
    color amber
  }
  tag sai {
    color red
  }

  relationship leitura {
    line dotted
  }
}
