specification {
  element pessoa {
    notation "Pessoa"
    style {
      shape person
      color muted
    }
  }
  element sistemaExterno {
    notation "Sistema externo"
    style {
      color secondary
    }
  }
  element sistema {
    notation "Sistema"
  }
  element conteiner {
    notation "Contêiner"
  }
  element componente {
    notation "Componente"
  }
  element banco {
    notation "Banco ou armazenamento"
    style {
      shape storage
    }
  }

  // Marcas do alvo (df-8x0m.23.37): o que difere de hoje.c4 leva uma delas e metadata { bead }
  // com o id de um bead aberto; scripts/arquitetura/marcas.py confere.
  tag novo {
    color green
  }
  tag muda {
    color amber
  }
  tag sai {
    color red
  }

  // Lido por uma tela ou pela API e roda na prod do Windows (df-8x0m.23.42): fechar um bead c4: de
  // um elemento com esta tag, ou de um descendente dele, pede "Servido pela prod:" no motivo
  // (scripts/beads/check.py, docs/bead-check.md).
  tag servidoPelaProd {
    color sky
  }

  // Onde cada contêiner roda (implantacao.c4).
  deploymentNode pc {
    notation "Computador"
  }
  deploymentNode ambiente {
    notation "Ambiente"
  }
  deploymentNode wsl {
    notation "WSL"
  }
  deploymentNode ci {
    notation "CI"
  }
  deploymentNode celular {
    notation "Celular"
    style {
      shape mobile
    }
  }

  relationship leitura {
    line dotted
  }
}
