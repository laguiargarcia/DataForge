views {
  view alvo-componentes-dataforge of casaAlvo.dataforgeAlvo {
    title 'Alvo v2: componentes do DataForge'
    description 'Quase todo componente usa o Compat (caminhos, banco, porta); essas setas estão no modelo e ficam fora desta vista'
    include *
    include * -> * where tag is #novo with {
      color green
    }
    include * -> * where tag is #muda with {
      color amber
    }
    include * -> * where tag is #sai with {
      color red
    }
    style element.tag = #novo {
      color green
      border dashed
    }
    style element.tag = #muda {
      color amber
    }
    style element.tag = #sai {
      color red
      border dotted
    }
    exclude * -> casaAlvo.dataforgeAlvo.compatAlvo
    // A cópia do backup e a conferência das publicadas são leitura; junto das gravações, deixariam
    // pontilhada a seta pipeline -> lago (df-8x0m.23.47.12).
    exclude casaAlvo.pipelineAlvo.backupDadosAlvo -> casaAlvo.lagoAlvo
    exclude casaAlvo.pipelineAlvo.publicadasAlvo -> casaAlvo.lagoAlvo
  }
  view alvo-componentes-servidor of casaAlvo.servidorAlvo {
    title 'Alvo v2: componentes do servidor da casa'
    include *
    include casaAlvo.pipelineAlvo.regrasAlvo, casaAlvo.dataforgeAlvo.cliAlvo
    include casaAlvo.appCelularAlvo.cascaTelasAlvo, casaAlvo.appCelularAlvo.listaTelasAlvo, casaAlvo.appCelularAlvo.desejosTelasAlvo, casaAlvo.appCelularAlvo.financasTelasAlvo, casaAlvo.appCelularAlvo.agendaTelasAlvo
    include * -> * where tag is #novo with {
      color green
    }
    include * -> * where tag is #muda with {
      color amber
    }
    include * -> * where tag is #sai with {
      color red
    }
    style element.tag = #novo {
      color green
      border dashed
    }
    style element.tag = #muda {
      color amber
    }
    style element.tag = #sai {
      color red
      border dotted
    }
  }
  view alvo-componentes-app-celular of casaAlvo.appCelularAlvo {
    title 'Alvo v2: componentes do app no celular'
    include *
    include casaAlvo.servidorAlvo.nucleoAlvo, casaAlvo.servidorAlvo.listaAlvo, casaAlvo.servidorAlvo.desejosAlvo, casaAlvo.servidorAlvo.agendaAlvo
    include * -> * where tag is #novo with {
      color green
    }
    include * -> * where tag is #muda with {
      color amber
    }
    include * -> * where tag is #sai with {
      color red
    }
    style element.tag = #novo {
      color green
      border dashed
    }
    style element.tag = #muda {
      color amber
    }
    style element.tag = #sai {
      color red
      border dotted
    }
  }
  view alvo-componentes-pipeline of casaAlvo.pipelineAlvo {
    title 'Alvo v2: componentes do pipeline do módulo finanças'
    include *
    include * -> * where tag is #novo with {
      color green
    }
    include * -> * where tag is #muda with {
      color amber
    }
    include * -> * where tag is #sai with {
      color red
    }
    style element.tag = #novo {
      color green
      border dashed
    }
    style element.tag = #muda {
      color amber
    }
    style element.tag = #sai {
      color red
      border dotted
    }
  }
}
