views {
  view alvo-componentes-dataforge of casaAlvo.dataforgeAlvo {
    title 'Alvo v2: componentes do DataForge'
    description 'Só o que muda e o que o liga; o resto segue como em hoje-componentes-dataforge'
    include *
    include casaAlvo.dataforgeAlvo.* -> * where tag is #novo with {
      color green
    }
    include * -> casaAlvo.dataforgeAlvo.* where tag is #novo with {
      color green
    }
    include casaAlvo.dataforgeAlvo.* -> * where tag is #muda with {
      color amber
    }
    include * -> casaAlvo.dataforgeAlvo.* where tag is #muda with {
      color amber
    }
    include casaAlvo.dataforgeAlvo.* -> * where tag is #sai with {
      color red
    }
    include * -> casaAlvo.dataforgeAlvo.* where tag is #sai with {
      color red
    }
    style element.tag = #novo {
      color green
      border dashed
    }
    style element.tag = #muda {
      color amber
    }
    style element.tag = #sai {
      color red
      border dotted
    }
    // A cópia do backup e a conferência das publicadas são leitura; junto das gravações, deixariam
    // pontilhada a seta pipeline -> lago (df-8x0m.23.47.12).
    exclude casaAlvo.pipelineAlvo.backupDadosAlvo -> casaAlvo.lagoAlvo
    exclude casaAlvo.pipelineAlvo.publicadasAlvo -> casaAlvo.lagoAlvo
    // As regras de tag trariam componentes do pipeline para dentro dele, e o LikeC4 deixaria de
    // desenhar as setas para o contêiner: o pipeline fica uma caixa só, e a seta direta das tasks
    // para ele, sem marca, leva a cor de sem marca.
    exclude casaAlvo.pipelineAlvo.*
    include casaAlvo.dataforgeAlvo.tasksAlvo -> casaAlvo.pipelineAlvo with {
      color gray
    }
    // A Definição lê e escreve os arquivos do workspace, um elemento do pipeline.
    include casaAlvo.pipelineAlvo.arquivosWorkspaceAlvo
  }
  view alvo-componentes-servidor of casaAlvo.servidorAlvo {
    title 'Alvo v2: componentes do servidor da casa'
    description 'Só o que muda e o que o liga; o resto segue como em hoje-componentes-ninho'
    include *
    // Mostra cada chamada das telas na tela que a faz, e as setas para o pipeline e o DataForge no
    // componente que elas atingem; as setas internas desses vizinhos ficam nas vistas deles.
    include casaAlvo.pipelineAlvo.regrasAlvo, casaAlvo.dataforgeAlvo.cliAlvo
    include casaAlvo.appCelularAlvo.cascaAlvo, casaAlvo.appCelularAlvo.listaTelasAlvo, casaAlvo.appCelularAlvo.desejosTelasAlvo, casaAlvo.appCelularAlvo.financasTelasAlvo, casaAlvo.appCelularAlvo.agendaTelasAlvo, casaAlvo.appCelularAlvo.copiaLocalAlvo
    include casaAlvo.servidorAlvo.* -> * where tag is #novo with {
      color green
    }
    include * -> casaAlvo.servidorAlvo.* where tag is #novo with {
      color green
    }
    include casaAlvo.servidorAlvo.* -> * where tag is #muda with {
      color amber
    }
    include * -> casaAlvo.servidorAlvo.* where tag is #muda with {
      color amber
    }
    include casaAlvo.servidorAlvo.* -> * where tag is #sai with {
      color red
    }
    include * -> casaAlvo.servidorAlvo.* where tag is #sai with {
      color red
    }
    style element.tag = #novo {
      color green
      border dashed
    }
    style element.tag = #muda {
      color amber
    }
    style element.tag = #sai {
      color red
      border dotted
    }
    exclude casaAlvo.appCelularAlvo.* -> casaAlvo.appCelularAlvo.*
    exclude donoAlvo -> casaAlvo.dataforgeAlvo.cliAlvo
    exclude donoAlvo -> casaAlvo.appCelularAlvo.cascaAlvo
    exclude outraAlvo -> casaAlvo.appCelularAlvo.cascaAlvo
  }
  view alvo-componentes-app-celular of casaAlvo.appCelularAlvo {
    title 'Alvo v2: componentes do app no celular'
    description 'Só o que muda e o que o liga; o resto segue como em hoje-componentes-telas'
    include *
    // Mostra cada chamada no componente do servidor que a atende; as setas internas do servidor ficam
    // na vista dele.
    include casaAlvo.servidorAlvo.nucleoAlvo, casaAlvo.servidorAlvo.listaAlvo, casaAlvo.servidorAlvo.desejosAlvo, casaAlvo.servidorAlvo.financasNinhoAlvo, casaAlvo.servidorAlvo.agendaAlvo
    include casaAlvo.appCelularAlvo.* -> * where tag is #novo with {
      color green
    }
    include * -> casaAlvo.appCelularAlvo.* where tag is #novo with {
      color green
    }
    include casaAlvo.appCelularAlvo.* -> * where tag is #muda with {
      color amber
    }
    include * -> casaAlvo.appCelularAlvo.* where tag is #muda with {
      color amber
    }
    include casaAlvo.appCelularAlvo.* -> * where tag is #sai with {
      color red
    }
    include * -> casaAlvo.appCelularAlvo.* where tag is #sai with {
      color red
    }
    style element.tag = #novo {
      color green
      border dashed
    }
    style element.tag = #muda {
      color amber
    }
    style element.tag = #sai {
      color red
      border dotted
    }
    exclude casaAlvo.servidorAlvo.* -> casaAlvo.servidorAlvo.*
    exclude casaAlvo.servidorAlvo.* -> casaAlvo.appCelularAlvo
  }
  view alvo-componentes-pipeline of casaAlvo.pipelineAlvo {
    title 'Alvo v2: componentes do pipeline do módulo finanças'
    description 'Só o que muda e o que o liga; o resto segue como em hoje-componentes-pipeline'
    include *
    // As regras de tag trazem as tasks do DataForge para a vista: as setas de lançar cada task saem delas.
    include casaAlvo.dataforgeAlvo.tasksAlvo -> casaAlvo.pipelineAlvo.*
    include casaAlvo.dataforgeAlvo.definicaoAlvo -> casaAlvo.pipelineAlvo.*
    include casaAlvo.pipelineAlvo.* -> * where tag is #novo with {
      color green
    }
    include * -> casaAlvo.pipelineAlvo.* where tag is #novo with {
      color green
    }
    include casaAlvo.pipelineAlvo.* -> * where tag is #muda with {
      color amber
    }
    include * -> casaAlvo.pipelineAlvo.* where tag is #muda with {
      color amber
    }
    include casaAlvo.pipelineAlvo.* -> * where tag is #sai with {
      color red
    }
    include * -> casaAlvo.pipelineAlvo.* where tag is #sai with {
      color red
    }
    style element.tag = #novo {
      color green
      border dashed
    }
    style element.tag = #muda {
      color amber
    }
    style element.tag = #sai {
      color red
      border dotted
    }
  }
}
