    pessoasCliAlvo = componente 'CLI de pessoas' {
      description 'python -m ninho pessoas criar, senha, modulos, sair e listar, rodado no PC do servidor: a senha só é pedida no terminal, duas vezes; abre o ninho.db direto (--banco ou NINHO_BANCO), sem passar pelo servidor'
      technology 'Python, argparse'
