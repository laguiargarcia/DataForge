// Estado de HOJE: tudo aqui roda em prod. Muda quando a prod muda.
model {
  donoHoje = pessoa 'Dono da casa' {
    description 'Usa o app Finanças e administra o DataForge e o ninho no PC; usa o ninho (lista, desejos, correções) no celular'
  }
  outraHoje = pessoa 'Outra pessoa da casa' {
    description 'Usa a lista de compras e os desejos pelo celular'
  }
  pluggyHoje = sistemaExterno 'Pluggy' {
    description 'Provedor de dados bancários'
  }
  agendadorHoje = sistemaExterno 'Agendador do Windows' {
    description 'Dispara o job diário e o backup (dataforge scheduled-run)'
  }

  casaHoje = sistema 'Sistema da casa' {
    description 'Tudo roda no PC da casa, em prod nativa no Windows; a rede privada é a Tailscale'

    dataforgeHoje = conteiner 'DataForge' {
      #servidoPelaProd
      description 'Motor, CLI, API e GUI Qt; serve o build do app Finanças, inicia o backend e repassa as chamadas a ele com o token. Processos do mesmo código: segundo plano (API e bandeja), GUI admin, janela do app, CLI e o run destacado (run --detach)'
      technology 'Python, FastAPI, PySide6'
      metadata {
        codigo ['dataforge']
      }
    }
    pipelineHoje = conteiner 'Pipeline GetFinance' {
      description 'As tasks dos jobs (finance_daily, extrato, reclassificar, backup) e a biblioteca de regras em scripts/report (edicao, classificacao, extrato), que o backend e o ninho importam'
      technology 'Python, polars, deltalake; um processo por task, lançado pelo DataForge'
      metadata {
        codigo ['workspaces/GetFinance']
      }
    }
    financasHoje = conteiner 'Backend GetFinance' {
      #servidoPelaProd
      description 'Processo do backend do app Finanças; importa internos do DataForge, que por sua vez o inicia e lhe repassa as chamadas: acoplamento nos dois sentidos, dor do ADR 0006'
      technology 'Python, FastAPI'
      metadata {
        codigo ['workspaces/GetFinance/apps/financas/backend']
      }
    }
    frontFinancasHoje = conteiner 'Front do app Finanças' {
      description 'As telas do app Finanças: tabelas, edição de categorias, regras e correções, conferência e extratos'
      technology 'React, TypeScript; na janela Qt do DataForge ou no navegador do PC'
      metadata {
        codigo ['workspaces/GetFinance/apps/financas']
      }
    }
    ninhoHoje = conteiner 'Servidor ninho' {
      #servidoPelaProd
      description 'Login por pessoa, lista de compras, lista de desejos e correção de categorias, em paralelo ao app Finanças; a CLI de pessoas (python -m ninho pessoas) abre o ninho.db direto'
      technology 'Python, FastAPI'
      metadata {
        codigo ['ninho']
      }
    }
    telasNinhoHoje = conteiner 'Telas do ninho' {
      description 'As telas do ninho: entrar, lista de compras, desejos e correções de finanças, com a identidade visual do ninho'
      technology 'React, TypeScript; web app no navegador do celular'
      metadata {
        codigo ['ninho/telas', 'ninho/identidade']
      }
    }
    bancoNinhoHoje = banco 'ninho.db' {
      #servidoPelaProd
      description 'Pessoas, lista de compras e desejos (fora do repositório; cópia semanal no job backup)'
      technology 'SQLite'
    }
    edicaoHoje = banco 'edicao.db' {
      #servidoPelaProd
      description 'Edições de finanças (data/ do workspace). Dois escritores em prod: ninho (correções) e backend Finanças (categorias, regras, correções, explicações); a semente carga_inicial_edicao rodou uma vez (só no finance_demo)'
      technology 'SQLite'
    }
    extratosHoje = banco 'Extratos em PDF' {
      #servidoPelaProd
      description 'PDFs do banco enviados pela tela do app Finanças; não se refazem'
      technology 'Pasta de arquivos (data/extratos)'
    }
    backupHoje = banco 'Zips do backup' {
      description 'Zip semanal de raw, edicao.db, ninho.db e extratos, fora de qualquer repositório; guarda os 8 mais novos. Ainda no mesmo disco (df-8x0m.19)'
      technology 'Pasta de zips, no mesmo disco'
    }
    lagoHoje = banco 'Lago de dados' {
      #servidoPelaProd
      description 'raw, cleansed e curated do GetFinance'
      technology 'Delta Lake'
    }
    dbDataforgeHoje = banco 'dataforge.db' {
      #servidoPelaProd
      description 'Histórico de execuções: o global (runs dos jobs) e um por workspace (cada task)'
      technology 'SQLite'
    }
  }

  donoHoje -> casaHoje.frontFinancasHoje 'Usa o app Finanças no PC (janela Qt ou navegador)'
  donoHoje -> casaHoje.dataforgeHoje 'Abre o app pelo atalho e administra o DataForge (GUI Qt, CLI)'
  donoHoje -> casaHoje.telasNinhoHoje 'Usa a lista, os desejos e as correções pelo celular'
  donoHoje -> casaHoje.ninhoHoje 'Cria pessoas, troca senhas e módulos pela CLI no PC (python -m ninho pessoas)'
  outraHoje -> casaHoje.telasNinhoHoje 'Usa a lista e os desejos pelo celular'
  agendadorHoje -> casaHoje.dataforgeHoje 'dataforge scheduled-run'
  casaHoje.dataforgeHoje -> agendadorHoje 'Registra e remove cada trigger como tarefa (register-triggers, pelo PowerShell)'
  casaHoje.pipelineHoje -> pluggyHoje 'Busca contas, transações, faturas e investimentos (task fetch do finance_daily)'

  casaHoje.frontFinancasHoje -> casaHoje.dataforgeHoje 'Baixa o build (dist); lê tabelas pela rota genérica e chama o backend pelo proxy /apps/<ws>/financas/api'
  casaHoje.telasNinhoHoje -> casaHoje.ninhoHoje 'Baixa o build (ninho/telas/dist) e chama /api (HTTPS pela Tailscale)'

  casaHoje.dataforgeHoje -> casaHoje.financasHoje 'Inicia e para o backend; repassa /apps/<ws>/financas/api com o token'
  casaHoje.dataforgeHoje -> casaHoje.pipelineHoje 'Lê o workspace.yaml e as conexões e edita jobs e triggers; lança cada task como processo Python, com o .env do job'
  casaHoje.dataforgeHoje -[leitura]-> casaHoje.lagoHoje 'Serve o curated pela rota genérica'
  casaHoje.dataforgeHoje -> casaHoje.dbDataforgeHoje 'Lê e escreve o histórico de execuções'

  casaHoje.financasHoje -> casaHoje.dataforgeHoje 'Importa internos (delta_pool, app_guard); pede e acompanha jobs pela API HTTP'
  casaHoje.financasHoje -> casaHoje.pipelineHoje 'Importa edicao, extrato e classificacao dos scripts (scripts/report); lê o connections.yaml'
  casaHoje.financasHoje -[leitura]-> casaHoje.lagoHoje 'Lê direto'
  casaHoje.financasHoje -> casaHoje.edicaoHoje 'Lê e escreve: categorias, regras, correções, explicações'
  casaHoje.financasHoje -> casaHoje.extratosHoje 'Grava o PDF enviado'

  casaHoje.pipelineHoje -> casaHoje.lagoHoje 'Grava raw, cleansed e curated; o job backup copia o raw'
  casaHoje.pipelineHoje -[leitura]-> casaHoje.edicaoHoje 'Lê (abrir_leitura); o job backup copia'
  casaHoje.pipelineHoje -[leitura]-> casaHoje.extratosHoje 'O job extrato relê; o job backup copia'
  casaHoje.pipelineHoje -> casaHoje.backupHoje 'Grava o zip semanal (job backup)'
  casaHoje.pipelineHoje -[leitura]-> casaHoje.bancoNinhoHoje 'Copia no job backup (semanal)'

  casaHoje.ninhoHoje -[leitura]-> casaHoje.lagoHoje 'Lê tabelas'
  casaHoje.ninhoHoje -> casaHoje.bancoNinhoHoje 'Lê e escreve: pessoas, lista, desejos'
  casaHoje.ninhoHoje -> casaHoje.edicaoHoje 'Lê e escreve: correções'
  casaHoje.ninhoHoje -> casaHoje.dataforgeHoje 'Pede o job (run --detach) e acompanha (run-state --wait) pela CLI'
  casaHoje.ninhoHoje -> casaHoje.pipelineHoje 'Importa edicao e classificacao dos scripts (provisório, df-8x0m.23.14); lê o connections.yaml e confere o workspace.yaml'
}

views {
  view hoje-contexto of casaHoje {
    title 'Hoje: contexto'
    include casaHoje, donoHoje, outraHoje, pluggyHoje, agendadorHoje
    include donoHoje -> casaHoje with {
      title 'Usa o app Finanças e administra o DataForge e o ninho no PC; usa o ninho no celular'
    }
  }
  view hoje-conteineres of casaHoje {
    title 'Hoje: contêineres'
    include casaHoje.*, donoHoje, outraHoje, pluggyHoje, agendadorHoje
    // A cópia do backup é leitura; junto das gravações, deixaria pontilhada a seta pipeline -> lago,
    // cujo título já diz que o job backup copia o raw (df-8x0m.23.47.12).
    exclude casaHoje.pipelineHoje.backupDadosHoje -> casaHoje.lagoHoje
    // As leituras dos arquivos do workspace também: o título de cada seta de contêiner já as diz (df-8x0m.23.47.14).
    exclude
      casaHoje.dataforgeHoje.compatHoje -> casaHoje.pipelineHoje.arquivosWorkspaceHoje,
      casaHoje.dataforgeHoje.apiHoje -> casaHoje.pipelineHoje.arquivosWorkspaceHoje,
      casaHoje.ninhoHoje.financasNinhoHoje -> casaHoje.pipelineHoje.arquivosWorkspaceHoje,
      casaHoje.ninhoHoje.servidorHoje -> casaHoje.pipelineHoje.arquivosWorkspaceHoje,
      casaHoje.financasHoje.rotasFinancasHoje -> casaHoje.pipelineHoje.arquivosWorkspaceHoje
  }
}
