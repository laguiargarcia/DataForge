// Componentes do contêiner Servidor ninho no HOJE (df-8x0m.23.47.4): o núcleo do servidor, a CLI de
// pessoas e os três módulos (lista, desejos, finanças), que é como ninho/ se divide em pacotes.
//
// Decisões (as razões estão nas notas do bead):
// - ninho/identidade é marca visual (README, PNG, SVG), sem código, e já é do contêiner Telas do ninho:
//   não entra aqui. ninho/telas também não (df-8x0m.23.47.5).
// - ninho/banco.py abre o edicao.db pelas regras do workspace e só finanças o usa: fica em finanças, e
//   não num componente de banco junto com servidor/banco.py, que abre o ninho.db e fica no núcleo. Um
//   componente de banco com os dois importaria finanças e seria importado por ela (ciclo).
// - Seta para fora sai do componente cujo código faz a leitura, a escrita ou a chamada. A CLI de pessoas
//   roda num processo seu e abre o ninho.db direto, sem o servidor: por isso tem a sua seta para o banco.
// - Finanças lê no connections.yaml do workspace onde está o edicao.db (ninho/banco.py), e o núcleo
//   confere pelo workspace.yaml que a pasta do NINHO_WORKSPACE é um workspace: as duas setas vão ao banco
//   dos arquivos do workspace, dentro do pipeline (df-8x0m.23.47.14).
// - A seta que é a única entre o ninho e um contêiner, banco ou pessoa de fora dá o rótulo da aresta da
//   vista de contêineres: o título diz também o que o contêiner faz ali (README, regra 5; df-8x0m.23.47.13).
model {
  extend casaHoje.ninhoHoje {
    servidorHoje = componente 'Núcleo do servidor' {
      description 'O app FastAPI (uvicorn ninho.servidor.app:app): entrar e sair por sessão com cookie, a pessoa da sessão e a checagem do módulo em cada rota, as rotas /api/financas, /api/eu e /api/pessoas, os routers da lista e dos desejos e o build das telas (ninho/telas/dist) em /; lê o NINHO_WORKSPACE, conferido pelo workspace.yaml da pasta, e passa a pasta às rotas de finanças; as tabelas pessoas (senha em scrypt) e sessoes do ninho.db, aberto pelo NINHO_BANCO'
      technology 'Python, FastAPI, SQLite'
      metadata {
        codigo ['ninho/__init__.py', 'ninho/servidor']
      }
    }
    pessoasCliHoje = componente 'CLI de pessoas' {
      description 'python -m ninho pessoas criar, senha, modulos, sair e listar, rodado no PC do servidor: a senha só é pedida no terminal, duas vezes; abre o ninho.db direto (--banco ou NINHO_BANCO), sem passar pelo servidor'
      technology 'Python, argparse'
      metadata {
        codigo ['ninho/__main__.py']
      }
    }
    listaHoje = componente 'Lista de compras' {
      description 'Rotas /api/lista e as regras dos itens (texto, comprado, quem adicionou) na tabela lista_itens do ninho.db, criada no primeiro uso'
      technology 'Python, FastAPI, SQLite'
      metadata {
        codigo ['ninho/lista']
      }
    }
    desejosHoje = componente 'Lista de desejos' {
      description 'Rotas /api/desejos e as regras dos desejos, das anotações (um endereço http ou https inteiro é link) e do presente surpresa, que o dono do desejo nunca vê, nas tabelas desejos_* do ninho.db, criadas no primeiro uso'
      technology 'Python, FastAPI, SQLite'
      metadata {
        codigo ['ninho/desejos']
      }
    }
    financasNinhoHoje = componente 'Finanças' {
      description 'O que as rotas /api/financas fazem: lê as transações do mês e a versão aplicada no curated; lê no connections.yaml do workspace onde está o edicao.db; nele, pelas regras do workspace, que carrega do scripts/report dele (provisório, df-8x0m.23.14), lê as categorias, as correções e a versão das edições e grava as correções (cada gravação sobe a versão); compara essa versão com a aplicada no curated para dizer se há edição pendente; e pede ao DataForge (NINHO_DATAFORGE, senão o dataforge do mesmo Python, com o DATAFORGE_HOME dois níveis acima do workspace) o job reclassificar que as aplica'
      technology 'Python, polars, deltalake, SQLite'
      metadata {
        codigo ['ninho/financas', 'ninho/banco.py']
      }
    }
  }

  // Imports entre os componentes.
  casaHoje.ninhoHoje.servidorHoje -> casaHoje.ninhoHoje.listaHoje 'Inclui o router /api/lista (só para quem tem o módulo lista)' {
    metadata {
      codigo ['ninho/servidor/app.py']
    }
  }
  casaHoje.ninhoHoje.servidorHoje -> casaHoje.ninhoHoje.desejosHoje 'Inclui o router /api/desejos (só para quem tem o módulo desejos)' {
    metadata {
      codigo ['ninho/servidor/app.py']
    }
  }
  casaHoje.ninhoHoje.servidorHoje -> casaHoje.ninhoHoje.financasNinhoHoje 'Atende /api/financas com a leitura, as edições e o aplicar (só para quem tem o módulo financas)' {
    metadata {
      codigo ['ninho/servidor/app.py']
    }
  }
  casaHoje.ninhoHoje.listaHoje -> casaHoje.ninhoHoje.servidorHoje 'Pede a pessoa da sessão e a conexão do ninho.db (dependencias)' {
    metadata {
      codigo ['ninho/lista/rotas.py']
    }
  }
  casaHoje.ninhoHoje.desejosHoje -> casaHoje.ninhoHoje.servidorHoje 'Pede a pessoa da sessão, as pessoas da casa e a conexão do ninho.db (dependencias)' {
    metadata {
      codigo ['ninho/desejos/rotas.py']
    }
  }
  casaHoje.ninhoHoje.pessoasCliHoje -> casaHoje.ninhoHoje.servidorHoje 'Usa as regras de pessoas e a abertura do ninho.db (pessoas, banco)' {
    metadata {
      codigo ['ninho/__main__.py']
    }
  }

  // Quem de fora chama.
  // Seta única do par dono -> ninho: o título dela é o rótulo da vista de contêineres (README, regra 5).
  donoHoje -> casaHoje.ninhoHoje.pessoasCliHoje 'Cria pessoas, troca senhas e módulos pela CLI no PC (python -m ninho pessoas)' {
    metadata {
      codigo ['ninho/__main__.py']
    }
  }
  // As chamadas das telas a /api saem dos componentes das telas (componentes-telas.c4, df-8x0m.23.47.5).

  // Para fora: telas, DataForge, regras do workspace, lago, bancos.
  casaHoje.ninhoHoje.servidorHoje -[leitura]-> casaHoje.telasNinhoHoje 'Lê o build (ninho/telas/dist) e o entrega em /' {
    metadata {
      codigo ['ninho/servidor/app.py']
    }
  }
  // As setas para a CLI do DataForge, o lago e o edicao.db são as únicas dos seus pares: o título de cada
  // uma é o rótulo da vista de contêineres (README, regra 5).
  casaHoje.ninhoHoje.financasNinhoHoje -> casaHoje.dataforgeHoje.cliHoje 'Pede o job (run --detach) e acompanha (run-state --wait) pela CLI' {
    metadata {
      codigo ['ninho/financas/aplicar.py']
    }
  }
  casaHoje.ninhoHoje.financasNinhoHoje -> casaHoje.pipelineHoje.regrasHoje 'Carrega edicao (que importa classificacao) do scripts/report do workspace e abre o edicao.db e lê e grava as correções por ele (provisório, df-8x0m.23.14)' {
    metadata {
      codigo ['ninho/financas/regras.py', 'ninho/banco.py', 'ninho/financas/edicoes.py']
    }
  }
  casaHoje.ninhoHoje.financasNinhoHoje -[leitura]-> casaHoje.pipelineHoje.arquivosWorkspaceHoje 'Lê no connections.yaml onde está o edicao.db' {
    metadata {
      codigo ['ninho/banco.py']
    }
  }
  casaHoje.ninhoHoje.servidorHoje -[leitura]-> casaHoje.pipelineHoje.arquivosWorkspaceHoje 'Confere pelo workspace.yaml que a pasta do NINHO_WORKSPACE é um workspace' {
    metadata {
      codigo ['ninho/servidor/app.py']
    }
  }
  casaHoje.ninhoHoje.financasNinhoHoje -[leitura]-> casaHoje.lagoHoje 'Lê tabelas' {
    metadata {
      codigo ['ninho/financas/leitura.py']
    }
  }
  casaHoje.ninhoHoje.financasNinhoHoje -> casaHoje.edicaoHoje 'Lê e escreve: correções' {
    metadata {
      codigo ['ninho/financas/edicoes.py', 'ninho/banco.py']
    }
  }
  casaHoje.ninhoHoje.servidorHoje -> casaHoje.bancoNinhoHoje 'Lê e escreve pessoas e sessões' {
    metadata {
      codigo ['ninho/servidor/banco.py', 'ninho/servidor/pessoas.py', 'ninho/servidor/sessoes.py']
    }
  }
  casaHoje.ninhoHoje.pessoasCliHoje -> casaHoje.bancoNinhoHoje 'Abre direto, sem o servidor: cria pessoas, troca senhas e módulos, encerra sessões' {
    metadata {
      codigo ['ninho/__main__.py']
    }
  }
  casaHoje.ninhoHoje.listaHoje -> casaHoje.bancoNinhoHoje 'Lê e escreve os itens da lista' {
    metadata {
      codigo ['ninho/lista/itens.py']
    }
  }
  casaHoje.ninhoHoje.desejosHoje -> casaHoje.bancoNinhoHoje 'Lê e escreve os desejos, as anotações e os presentes' {
    metadata {
      codigo ['ninho/desejos/desejos.py']
    }
  }
}

views {
  view hoje-componentes-ninho of casaHoje.ninhoHoje {
    title 'Hoje: componentes do servidor ninho'
    include *
    // Mostra a seta da carga das regras no componente que ela atinge, não no contêiner do pipeline.
    include casaHoje.pipelineHoje.regrasHoje
    // E a dos arquivos do workspace (connections.yaml, workspace.yaml), também no banco que elas atingem.
    include casaHoje.pipelineHoje.arquivosWorkspaceHoje
    // Mostra a seta do aplicar na CLI do DataForge, não no contêiner do DataForge.
    include casaHoje.dataforgeHoje.cliHoje
    include casaHoje.telasNinhoHoje
    // Três setas dos componentes das telas chegam ao núcleo (componentes-telas.c4): sem um título dado
    // aqui, a aresta sai '[...]' (df-8x0m.23.47.12).
    include casaHoje.telasNinhoHoje -> casaHoje.ninhoHoje.servidorHoje with {
      title 'Baixa a página, entra, sai, lê quem entrou e as pessoas, e chama /api/financas'
    }
  }
}
