// ALVO v2 (ADR 0006). Nada disto está pronto; o que já existe em prod está em hoje.c4.
model {
  donoAlvo = pessoa 'Dono da casa' {
    description 'Finanças, lista e agenda'
  }
  outraAlvo = pessoa 'Outra pessoa da casa' {
    description 'Vê o que é compartilhado e o que é dela'
  }
  pluggyAlvo = sistemaExterno 'Pluggy' {
    description 'Provedor de dados bancários'
  }
  outrasFontesAlvo = sistemaExterno 'Outras fontes' {
    #aFazer
    description 'Segunda fonte de dados (df-8x0m.23.10)'
  }
  tailscaleAlvo = sistemaExterno 'Tailscale' {
    description 'Rede privada até o celular'
  }
  agendadorAlvo = sistemaExterno 'Agendador do Windows' {
    description 'Dispara os jobs'
  }

  casaAlvo = sistema 'Casa (PC com Windows)' {
    description 'Quatro peças com contratos estreitos'

    servidorAlvo = conteiner 'Servidor da casa (ninho) e telas' {
      description 'Único processo sempre ligado; conhece pessoas e login. Módulos: finanças, lista, agenda. Nunca roda pipeline nem escreve no lago'
      technology 'Python, FastAPI, front web'
    }
    bancoAppAlvo = banco 'Banco do app' {
      description 'O que a pessoa digitou: usuários, lista, agenda, edições. Não se reconstrói: precisa de backup real'
      technology 'SQLite'
    }
    lagoAlvo = banco 'Lago' {
      description 'raw (só cresce), cleansed e publicado. Só o pipeline escreve'
      technology 'Delta Lake'
    }
    dataforgeAlvo = conteiner 'DataForge (orquestrador)' {
      description 'Motor, agendador, histórico, CLI e tela de admin. Roda e termina; não serve dados nem conhece usuário'
      technology 'Python'
    }
    consultaAlvo = conteiner 'Consulta de estado de execução' {
      #aDecidir
      description 'Como o servidor acompanha uma execução que pediu (df-8x0m.23.17)'
    }
  }

  donoAlvo -> tailscaleAlvo 'Celular e navegador do PC'
  outraAlvo -> tailscaleAlvo 'Celular'
  tailscaleAlvo -> casaAlvo.servidorAlvo 'HTTPS na rede privada'
  agendadorAlvo -> casaAlvo.dataforgeAlvo 'dataforge run'

  casaAlvo.servidorAlvo -[leitura]-> casaAlvo.bancoAppAlvo 'Lê'
  casaAlvo.servidorAlvo -[escrita]-> casaAlvo.bancoAppAlvo 'Único escritor'
  casaAlvo.servidorAlvo -[leitura]-> casaAlvo.lagoAlvo 'Só leitura, pelas tabelas publicadas'
  casaAlvo.servidorAlvo -> casaAlvo.dataforgeAlvo 'Pede "rode o job X" pela interface pública (CLI)'
  casaAlvo.servidorAlvo -> casaAlvo.consultaAlvo 'Acompanha a execução'
  casaAlvo.consultaAlvo -> casaAlvo.dataforgeAlvo 'Lê o histórico'
  casaAlvo.dataforgeAlvo -[escrita]-> casaAlvo.lagoAlvo 'Único escritor'
  casaAlvo.dataforgeAlvo -[leitura]-> casaAlvo.bancoAppAlvo 'Lê as edições como entrada'
  casaAlvo.dataforgeAlvo -> pluggyAlvo 'Busca dados'
  casaAlvo.dataforgeAlvo -> outrasFontesAlvo 'Busca dados'
}

views {
  view alvo-contexto of casaAlvo {
    title 'Alvo v2: contexto'
    include *
    include donoAlvo, outraAlvo, pluggyAlvo, outrasFontesAlvo, tailscaleAlvo, agendadorAlvo
  }
  view alvo-conteineres of casaAlvo {
    title 'Alvo v2: contêineres'
    include casaAlvo.*
    include donoAlvo, outraAlvo, pluggyAlvo, outrasFontesAlvo, tailscaleAlvo, agendadorAlvo
  }
}
