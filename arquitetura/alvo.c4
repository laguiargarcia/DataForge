// ALVO v2 (ADR 0006). Cada elemento ou seta que difere de hoje.c4 leva uma marca, #novo (ainda não
// existe), #muda (existe e vai mudar) ou #sai (existe hoje e vai sumir), e metadata { bead } com o
// id de um bead aberto, ou uma lista deles (df-8x0m.23.37). Sem marca: já roda em prod como está.
// Quando o bead fecha, a marca sai, ou passa para o bead que continua a mudança.
model {
  donoAlvo = pessoa 'Dono da casa' {
    description 'Finanças, lista e agenda; administra o DataForge'
  }
  outraAlvo = pessoa 'Outra pessoa da casa' {
    description 'Vê o que é compartilhado e o que é dela'
  }
  pluggyAlvo = sistemaExterno 'Pluggy' {
    description 'Provedor de dados bancários'
  }
  outrasFontesAlvo = sistemaExterno 'Outras fontes' {
    #novo
    description 'Segunda fonte de dados, que entra pelo mesmo lugar que o Pluggy'
    metadata {
      bead 'df-8x0m.23.10'
    }
  }
  agendadorAlvo = sistemaExterno 'Agendador do Windows' {
    description 'Dispara os jobs (dataforge scheduled-run)'
  }

  casaAlvo = sistema 'Sistema da casa' {
    description 'Quatro peças com contratos estreitos; o servidor e o DataForge rodam no PC da casa, o app no celular'

    appCelularAlvo = conteiner 'App no celular' {
      #muda
      technology 'Web app instalada no celular'
      description 'As telas do ninho (ninho/telas), abertas como app na tela de início. Muda: cópia local do que mostra e fila de mudanças enviada ao servidor quando a rede volta'
      metadata {
        bead 'df-8x0m.23.8'
        codigo ['ninho/telas', 'ninho/identidade']
      }
    }
    servidorAlvo = conteiner 'Servidor da casa (ninho)' {
      #muda
      description 'Roda no PC da casa. Único processo sempre ligado; conhece pessoas e login; serve as telas. Módulos: finanças, lista, desejos, agenda. Nunca roda pipeline nem escreve no lago. Muda: o módulo finanças faz o que o app Finanças do PC faz hoje; a agenda entra'
      technology 'Python, FastAPI'
      metadata {
        bead ['df-8x0m.23.19', 'df-8x0m.23.21']
        codigo ['ninho']
      }
    }
    bancoAppAlvo = banco 'Banco do app' {
      #muda #servidoPelaProd
      description 'O que a pessoa digitou: usuários, lista, desejos, agenda, edições. Não se reconstrói: cópia semanal pelo job backup já em prod. Muda: hoje são dois arquivos SQLite, ninho.db (pessoas, lista, desejos) e o edicao.db do workspace (edições), até o workspace ir para ninho/financas; falta a cópia fora deste disco; onde moram os extratos em PDF está a decidir'
      technology 'SQLite'
      metadata {
        bead ['df-8x0m.23.14', 'df-8x0m.23.9', 'df-8x0m.19', 'df-8x0m.23.35']
      }
    }
    lagoAlvo = banco 'Lago' {
      #muda #servidoPelaProd
      description 'raw (só cresce), cleansed e publicado. Só o pipeline escreve. Muda: as tabelas publicadas viram uma lista com esquema declarado, conferida ao fim de cada job que as escreve'
      technology 'Delta Lake'
      metadata {
        bead 'df-8x0m.23.45'
      }
    }
    dataforgeAlvo = conteiner 'DataForge (orquestrador)' {
      #muda
      description 'Roda no PC da casa. Motor, agendador, histórico, CLI e tela de admin. Roda e termina; não serve dados nem conhece usuário. Muda: sai o que não é orquestrador (hospedeiro de apps, rota genérica de tabelas); paredes no repositório: pastas, pacotes e regra do gate separados, CI por parte'
      technology 'Python'
      metadata {
        bead ['df-8x0m.23.3', 'df-8x0m.23.14']
        codigo ['dataforge']
      }
    }
    pipelineAlvo = conteiner 'Pipeline do módulo finanças' {
      #muda
      description 'As tasks dos jobs (finance_daily, extrato, reclassificar, backup), cada uma um processo lançado pelo DataForge, e o pacote de regras de edição e classificação, que o servidor também importa. Único escritor do lago. Muda: sai de workspaces/GetFinance para ninho/financas, e as regras viram um pacote importável no lugar de scripts/report carregado por sys.path'
      technology 'Python, polars, deltalake; um processo por task, lançado pelo DataForge'
      metadata {
        bead 'df-8x0m.23.14'
        codigo ['workspaces/GetFinance']
      }
    }
    historicoAlvo = banco 'Histórico e agendas' {
      #servidoPelaProd
      description 'Escrito só pelo DataForge; o servidor sabe o estado de uma execução por run-state, nunca lê o arquivo'
      technology 'SQLite (dataforge.db)'
    }
    financasAlvo = conteiner 'Backend GetFinance' {
      #sai #servidoPelaProd
      description 'O backend do app Finanças do PC, iniciado pelo DataForge: segundo escritor das edições, lê o lago direto e importa internos do DataForge e as regras do pipeline. Sai: o que ele faz passa para o módulo finanças do servidor (df-8x0m.23.19), e o DataForge deixa de hospedar apps (df-8x0m.23.3)'
      technology 'Python, FastAPI'
      metadata {
        bead ['df-8x0m.23.3', 'df-8x0m.23.19']
        codigo ['workspaces/GetFinance/apps/financas/backend']
      }
    }
    frontFinancasAlvo = conteiner 'Front do app Finanças' {
      #sai #servidoPelaProd
      description 'As telas do app Finanças no PC: tabelas, edição de categorias, regras e correções, conferência e extratos. Sai: as telas passam para a tela de finanças do app no celular (df-8x0m.23.19), e o DataForge deixa de servir o build e a rota de tabelas (df-8x0m.23.3)'
      technology 'React, TypeScript; na janela Qt do DataForge ou no navegador do PC'
      metadata {
        bead ['df-8x0m.23.19', 'df-8x0m.23.3']
        codigo ['workspaces/GetFinance/apps/financas']
      }
    }
  }

  donoAlvo -> casaAlvo.appCelularAlvo 'Usa a lista, os desejos, as finanças e a agenda pelo celular' {
    #muda
    metadata {
      bead ['df-8x0m.23.19', 'df-8x0m.23.21']
    }
  }
  outraAlvo -> casaAlvo.appCelularAlvo 'Usa a lista, os desejos e a agenda pelo celular' {
    #muda
    metadata {
      bead ['df-8x0m.23.21', 'df-8x0m.23.6']
    }
  }
  casaAlvo.appCelularAlvo -> casaAlvo.servidorAlvo 'Lê e envia a fila de mudanças (HTTPS pela Tailscale)' {
    #muda
    metadata {
      bead 'df-8x0m.23.8'
    }
  }
  donoAlvo -> casaAlvo.dataforgeAlvo 'Administra pela tela de admin e pela CLI' {
    #muda
    metadata {
      bead 'df-8x0m.23.3'
    }
  }
  donoAlvo -> casaAlvo.servidorAlvo 'Cria pessoas, troca senhas e módulos pela CLI no PC (python -m ninho pessoas)'
  donoAlvo -> casaAlvo.frontFinancasAlvo 'Usa o app Finanças no PC (janela Qt ou navegador)' {
    #sai
    metadata {
      bead 'df-8x0m.23.19'
    }
  }
  agendadorAlvo -> casaAlvo.dataforgeAlvo 'dataforge scheduled-run'
  casaAlvo.dataforgeAlvo -> agendadorAlvo 'Registra e remove cada trigger como tarefa (register-triggers, pelo PowerShell)'

  casaAlvo.servidorAlvo -> casaAlvo.bancoAppAlvo 'Lê e escreve (único escritor)' {
    #muda
    metadata {
      bead 'df-8x0m.23.14'
    }
  }
  casaAlvo.servidorAlvo -[leitura]-> casaAlvo.lagoAlvo 'Só leitura, pelas tabelas publicadas' {
    #muda
    metadata {
      bead 'df-8x0m.23.45'
    }
  }
  casaAlvo.servidorAlvo -> casaAlvo.dataforgeAlvo 'Pede o job e acompanha pela interface pública (run --detach / run-state --wait)'
  casaAlvo.dataforgeAlvo -> casaAlvo.historicoAlvo 'Lê e escreve (único escritor)'
  casaAlvo.dataforgeAlvo -> casaAlvo.pipelineAlvo 'Lê o workspace.yaml e as conexões e edita jobs e triggers; lança cada task como processo Python, com o .env do job'
  casaAlvo.dataforgeAlvo -[leitura]-> casaAlvo.lagoAlvo 'Serve o curated pela rota genérica' {
    #sai
    metadata {
      bead 'df-8x0m.23.3'
    }
  }
  casaAlvo.pipelineAlvo -> casaAlvo.lagoAlvo 'Grava raw, cleansed e publicado (único escritor); o job backup copia o raw' {
    #muda
    metadata {
      bead ['df-8x0m.23.45', 'df-8x0m.23.10']
    }
  }
  casaAlvo.pipelineAlvo -[leitura]-> casaAlvo.bancoAppAlvo 'Lê as edições como entrada (abrir_leitura); o job backup copia' {
    #muda
    metadata {
      bead 'df-8x0m.23.14'
    }
  }
  casaAlvo.pipelineAlvo -> pluggyAlvo 'Busca contas, transações, faturas e investimentos (task fetch do finance_daily)'
  casaAlvo.pipelineAlvo -> outrasFontesAlvo 'Busca dados' {
    #novo
    metadata {
      bead 'df-8x0m.23.10'
    }
  }
  casaAlvo.frontFinancasAlvo -> casaAlvo.dataforgeAlvo 'Baixa o build (dist); lê tabelas pela rota genérica e chama o backend pelo proxy /apps/<ws>/financas/api' {
    #sai
    metadata {
      bead ['df-8x0m.23.19', 'df-8x0m.23.3']
    }
  }
  casaAlvo.dataforgeAlvo -> casaAlvo.financasAlvo 'Inicia e para o backend; repassa as chamadas do app Finanças' {
    #sai
    metadata {
      bead 'df-8x0m.23.3'
    }
  }
  casaAlvo.financasAlvo -> casaAlvo.bancoAppAlvo 'Lê e escreve as edições (segundo escritor)' {
    #sai
    metadata {
      bead 'df-8x0m.23.3'
    }
  }
  casaAlvo.financasAlvo -> casaAlvo.dataforgeAlvo 'Importa internos (delta_pool, app_guard); pede e acompanha jobs pela API HTTP' {
    #sai
    metadata {
      bead 'df-8x0m.23.3'
    }
  }
  casaAlvo.financasAlvo -[leitura]-> casaAlvo.lagoAlvo 'Lê direto, fora das tabelas publicadas' {
    #sai
    metadata {
      bead 'df-8x0m.23.3'
    }
  }
  casaAlvo.financasAlvo -> casaAlvo.pipelineAlvo 'Importa edicao, extrato e classificacao dos scripts (scripts/report); lê o connections.yaml' {
    #sai
    metadata {
      bead 'df-8x0m.23.3'
    }
  }
  casaAlvo.servidorAlvo -> casaAlvo.pipelineAlvo 'Importa o pacote de regras de edição e classificação' {
    #muda
    metadata {
      bead 'df-8x0m.23.14'
    }
  }
}

views {
  view alvo-contexto of casaAlvo {
    title 'Alvo v2: contexto'
    include casaAlvo, donoAlvo, outraAlvo, pluggyAlvo, outrasFontesAlvo, agendadorAlvo
    include * -> * where tag is #novo with {
      color green
    }
    include * -> * where tag is #muda with {
      color amber
    }
    include * -> * where tag is #sai with {
      color red
    }
    style element.tag = #novo {
      color green
      border dashed
    }
    style element.tag = #muda {
      color amber
    }
    style element.tag = #sai {
      color red
      border dotted
    }
    // Depois das regras de tag: uma aresta que junta setas de marcas diferentes pegaria a cor de uma
    // delas. Cada uma leva a cor da seta daquele nível (componentes-alvo.c4, cabeçalho).
    include donoAlvo -> casaAlvo with {
      title 'Usa o app no celular; administra o DataForge e o ninho no PC; o app Finanças do PC sai'
      color amber
    }
    include casaAlvo -> agendadorAlvo with {
      color gray
    }
  }
  view alvo-conteineres of casaAlvo {
    title 'Alvo v2: contêineres'
    include casaAlvo.*, donoAlvo, outraAlvo, pluggyAlvo, outrasFontesAlvo, agendadorAlvo
    include * -> * where tag is #novo with {
      color green
    }
    include * -> * where tag is #muda with {
      color amber
    }
    include * -> * where tag is #sai with {
      color red
    }
    style element.tag = #novo {
      color green
      border dashed
    }
    style element.tag = #muda {
      color amber
    }
    style element.tag = #sai {
      color red
      border dotted
    }
    // A cópia do backup e a conferência das publicadas são leitura; junto das gravações, deixariam
    // pontilhada a seta pipeline -> lago, cujo título já diz que o job backup copia o raw
    // (componentes-alvo.c4; df-8x0m.23.47.12).
    exclude casaAlvo.pipelineAlvo.backupDadosAlvo -> casaAlvo.lagoAlvo
    exclude casaAlvo.pipelineAlvo.publicadasAlvo -> casaAlvo.lagoAlvo
    // Depois das regras de tag: as setas de contêiner sem marca levam a cor de sem marca, não a de
    // uma seta de componente marcada juntada nelas (componentes-alvo.c4, cabeçalho).
    include casaAlvo.dataforgeAlvo -> casaAlvo.pipelineAlvo with {
      color gray
    }
    include casaAlvo.dataforgeAlvo -> agendadorAlvo with {
      color gray
    }
    // Depois do include acima, que traria de volta todas as setas do par: a leitura dos arquivos do
    // workspace pelo Compat, junto das setas comuns, deixaria pontilhada a seta dataforge -> pipeline,
    // cujo título já diz que o DataForge lê o workspace.yaml (como em hoje.c4).
    exclude casaAlvo.dataforgeAlvo.compatAlvo -> casaAlvo.pipelineAlvo.arquivosWorkspaceAlvo
  }
}

views {
  view index {
    title 'Índice'
    include casaHoje, casaAlvo
  }
}
