# Python
.venv/
__pycache__/
*.pyc
*.pyo
dist/
*.egg-info/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.testloop/
.hypothesis/
mutants/
scripts/testloop/evals/
# Quality-gate baseline for gitignored (private) files: their paths must not be published
scripts/quality/baseline.local.json
/tests/test_testloop_evals.py

# Logs / temp
*.log
logs/

# Secrets
.env

# Owner-local leak-guard name patterns (private; loaded by scripts/leakguard.py at runtime)
.leakguard-local

# Claude / AI tooling (private — never published)
# NOTE: a bare pattern like ".claude/" matches at ANY depth, so stray agent
# settings created in subdirs (e.g. workspaces/.../aux/.claude/) are covered too.
.claude/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.mcp.json
.superpowers/

# Planning, issue tracking, knowledge graph (private — never published)
.planning/
.beads/
.dolt/
.beads-credential-key
.code-review-graph/

# Git worktrees
.worktrees/

# Engine tests (fake data) are public and run in CI. Pipeline tests that read the
# real GetFinance workspaces stay private, as do docs and the local pytest config.
/tests/workspaces/
/tests/test_finance_daily_dag.py
docs/
/pytest.ini

# Data & binary outputs (regenerated by the generator/pipeline; never committed)
*.db
*.duckdb
*.xls
*.parquet
data/
workspaces/*/data/
workspaces/*/data/bridge/

# Excel workbooks are never committed (the report is no longer an Excel deliverable).
*.xlsx

# Machine-specific schedules — each environment arms its own triggers; never shared
workspaces/*/triggers/

# Report scratch / deploy state (regenerated; never shared)
workspaces/*/report/aux/
workspaces/*/report/aux/backups/
workspaces/*/deploy/.ledger/

# Per-user holdings config (ship investments.example.yaml; Show's SYNTHETIC map is
# whitelisted at the bottom so the demo's dim_investment has rows on a fresh clone).
workspaces/*/config/investments.yaml

# REAL workspaces — present on disk for the owner's daily work, NEVER published.
# (After the rename, the bare name `GetFinance` is the real PROD workspace.)
workspaces/GetFinance/
workspaces/GetFinance-Dev/

# Frontend tooling artefacts
node_modules/
test-results/
playwright-report/

# ── Narrow whitelists (MUST stay last; negations override the broad ignores above) ──
# Ship Show's SYNTHETIC holdings map (required for dim_investment on a fresh clone).
!workspaces/GetFinance-Show/config/investments.yaml
# Ship the Show apps' built front (dist/).
!workspaces/GetFinance-Show/apps/*/dist/
!workspaces/GetFinance-Show/apps/*/dist/**
