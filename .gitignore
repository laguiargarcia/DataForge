# Python
.venv/
__pycache__/
*.pyc
*.pyo
dist/
*.egg-info/

# Test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.testloop/
.hypothesis/
mutants/
scripts/testloop/evals/
# Quality-gate baseline for gitignored (private) files: their paths must not be published
scripts/quality/baseline.local.json
/tests/test_testloop_evals.py

# Logs / temp
*.log
logs/
# DataForge runtime state under the home (run/start locks, app window web profile)
/locks/
/webengine/

# Secrets
.env

# Owner-local leak-guard name patterns (private; loaded by scripts/leakguard_patterns.py at runtime)
.leakguard-local
# Owner-local list of private workspaces outside the checkout (dev clone on ext4, workspace on C:)
.leakguard-workspaces

# Claude / AI tooling (private — never published)
# NOTE: a bare pattern like ".claude/" matches at ANY depth, so stray agent
# settings created in subdirs (e.g. workspaces/.../aux/.claude/) are covered too.
.claude/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.mcp.json
.superpowers/

# Planning, issue tracking, knowledge graph (private — never published)
.planning/
.beads/
.dolt/
.beads-credential-key
.code-review-graph/

# Git worktrees
.worktrees/

# Engine tests (fake data) are public and run in CI. Pipeline tests that read the
# real GetFinance workspaces stay private, as does the local pytest config.
/tests/workspaces/
/tests/test_finance_daily_dag.py
/pytest.ini

# docs/ is versioned (df-azm6), except its history, which holds real values, and the owner's
# workbook note. The same paths are in BLOCK_PREFIXES of scripts/leakguard_files.py.
/docs/superpowers/
/docs/phases/
/docs/gsd-workflow.md
/docs/workbook-handoff.md

# Data & binary outputs (regenerated by the generator/pipeline; never committed)
*.db
*.duckdb
*.xls
*.parquet
data/
workspaces/*/data/
workspaces/*/data/bridge/

# Excel workbooks are never committed (the report is no longer an Excel deliverable).
*.xlsx

# Machine-specific schedules — each environment arms its own triggers; never shared
workspaces/*/triggers/

# Report scratch / deploy state (regenerated; never shared)
workspaces/*/report/aux/
workspaces/*/report/aux/backups/
workspaces/*/deploy/.ledger/

# Per-user holdings config (ship investments.example.yaml; GetFinance's demo map is
# config/investments.synthetic.yaml, a different name, so it is tracked as is).
workspaces/*/config/investments.yaml

# REAL workspaces — present on disk for the owner's daily work, NEVER published.
workspaces/GetFinance-Dev/

# GetFinance's code is public; its prod checkout also holds the owner's real data and settings,
# which stay out of git. (.env, *.db, *.xlsx, *.parquet and data/ are ignored everywhere above.)
workspaces/GetFinance/.env.*
!workspaces/GetFinance/.env.example
workspaces/GetFinance/report/
workspaces/GetFinance/**/*.xlsm
# GetFinance's own docs are shipped, except the ones that hold real values and names.
workspaces/GetFinance/docs/archive/
workspaces/GetFinance/docs/workbook.md

# Frontend tooling artefacts
node_modules/
test-results/
playwright-report/

# ── Narrow whitelists (MUST stay last; negations override the broad ignores above) ──
# Ship the GetFinance apps' built front (dist/).
!workspaces/GetFinance/apps/*/dist/
!workspaces/GetFinance/apps/*/dist/**
# Ship the ninho screen's built front too: the ninho server hands it out (df-8x0m.23.13.5).
!ninho/telas/dist/
!ninho/telas/dist/**
arquitetura/dist/
